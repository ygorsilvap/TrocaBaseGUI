<Page x:Class="TrocaBaseGUI.Views.TresCParamsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TrocaBaseGUI.Views"
      mc:Ignorable="d" 
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Height="500" Width="550"
      Title="TresCParamsPage">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="427"/>
        </Grid.RowDefinitions>

        <TextBlock Foreground="#7737A6" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="75,223,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="151" Height="16" Grid.Row="1" Text="Configuração 3 Camadas:"/>
        <Rectangle RadiusX="1" RadiusY="1" Height="2" Margin="79,240,182,0" Grid.Row="1" Stroke="#7737A6" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Rectangle.RenderTransform>
        </Rectangle>

        <CheckBox x:Name="loginCheckbox" IsTabStop="False" BorderBrush="#411e5a" Background="#f5f4f3" IsChecked="{Binding appState.Settings.DefaultLoginCheckbox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="loginCheckbox_Checked" Content="CheckBox" HorizontalAlignment="Right" Margin="0,62,460,0" Grid.Row="1" VerticalAlignment="Top" Width="15" Height="15"/>
        <TextBlock Foreground="#411e5a" HorizontalAlignment="Left" Margin="100,61,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="75" Height="17" Grid.Row="1"><Run Text="Login Padrão"/><Run Language="pt-br" Text=":"/><LineBreak/><Run Language="pt-br"/><LineBreak/><Run/></TextBlock>
        <TextBox x:Name="loginPadrao" Text="{Binding appState.Settings.DefaultLogin, Mode=TwoWay}" Foreground="Black" FontSize="11" Padding="1, 0" Margin="195,62,205,347" Grid.Row="1">
            <TextBox.Style>
                <Style TargetType="TextBox">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <Border x:Name="Border"
                                    Background="#f5f4f3"  
                                    BorderBrush="#411e5a"  
                                    BorderThickness="1.5"  
                                    CornerRadius="4">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#A6A5A4"/>
                                        <Setter TargetName="Border" Property="Background" Value="#EBE9E8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.Style>
        </TextBox>

        <CheckBox x:Name="senhaCheckbox" IsTabStop="False" BorderBrush="#411e5a" Background="#f5f4f3" IsChecked="{Binding appState.Settings.DefaultPasswordCheckbox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="senhaCheckbox_Checked" Content="CheckBox" HorizontalAlignment="Left" Margin="75,92,0,0" Grid.Row="1" VerticalAlignment="Top" Width="15"/>
        <TextBlock Foreground="#411e5a" HorizontalAlignment="Left" Margin="100,91,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="85" Height="17" Grid.Row="1"><Run Language="pt-br" Text="Senha"/><Run Text=" Padrão"/><Run Text=":"/><LineBreak/><Run/><LineBreak/><Run/></TextBlock>
        <TextBox x:Name="senhaPadrao" Text="{Binding appState.Settings.DefaultPassword, Mode=TwoWay}" Foreground="Black" FontSize="11" Padding="1, 0" Margin="195,92,205,317" Grid.Row="1">
            <TextBox.Style>
                <Style TargetType="{x:Type TextBox}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TextBox}">
                                <Border x:Name="Border"
                                    Background="#f5f4f3"  
                                    BorderBrush="#411e5a"  
                                    BorderThickness="1.5"   
                                    CornerRadius="4">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#A6A5A4"/>
                                        <Setter TargetName="Border" Property="Background" Value="#EBE9E8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.Style>
        </TextBox>

        <CheckBox x:Name="editorCheckbox" IsTabStop="False" BorderBrush="#411e5a" Background="#f5f4f3" IsChecked="{Binding appState.Settings.EditorCheckbox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="editorCheckbox_Checked" Content="CheckBox" HorizontalAlignment="Left" Margin="75,132,0,0" Grid.Row="1" VerticalAlignment="Top" Width="15"/>
        <TextBlock Foreground="#411e5a" HorizontalAlignment="Left" Margin="100,131,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="85" Height="17" Grid.Row="1"><Run Language="pt-br" Text="Editor de Texto:"/></TextBlock>
        <TextBox x:Name="editorTexto" Text="{Binding appState.Settings.TextEditorPath, Mode=TwoWay}" Foreground="Black" FontSize="11" Padding="1, 0" Margin="195,132,205,277" Grid.Row="1">
            <TextBox.Style>
                <Style TargetType="{x:Type TextBox}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TextBox}">
                                <Border x:Name="Border"
                                    Background="#f5f4f3"  
                                    BorderBrush="#411e5a"  
                                    BorderThickness="1.5"   
                                    CornerRadius="4">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#A6A5A4"/>
                                        <Setter TargetName="Border" Property="Background" Value="#EBE9E8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.Style>
        </TextBox>

        <CheckBox x:Name="updateFolderCheckbox" IsTabStop="False" BorderBrush="#411e5a" Background="#f5f4f3" IsChecked="{Binding appState.Settings.DirUpdateCheckbox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="updateFolderCheckbox_Checked" Content="CheckBox" HorizontalAlignment="Left" Margin="75,162,0,0" Grid.Row="1" VerticalAlignment="Top" Width="15"/>
        <TextBlock Foreground="#411e5a" HorizontalAlignment="Left" Margin="100,161,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="85" Height="17" Grid.Row="1"><Run Language="pt-br" Text="Dir. Atualização:"/></TextBlock>
        <TextBox x:Name="updateFolder" Text="{Binding appState.Settings.UpdateFolder, Mode=TwoWay}" Foreground="Black" FontSize="11" Padding="1, 0" Margin="195,162,205,247" Grid.Row="1">
            <TextBox.Style>
                <Style TargetType="{x:Type TextBox}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TextBox}">
                                <Border x:Name="Border"
                                    Background="#f5f4f3"  
                                    BorderBrush="#411e5a"  
                                    BorderThickness="1.5"  
                                    CornerRadius="4">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#A6A5A4"/>
                                        <Setter TargetName="Border" Property="Background" Value="#EBE9E8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.Style>
        </TextBox>

        <CheckBox x:Name="usaConciliadorCheckbox" IsTabStop="False" BorderBrush="#411e5a" Background="#f5f4f3" IsChecked="{Binding appState.Settings.UsaConciliador, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="CheckBox" HorizontalAlignment="Left" Margin="75,192,0,0" Grid.Row="1" VerticalAlignment="Top" Width="15"/>
        <TextBlock Foreground="#411e5a" HorizontalAlignment="Left" Margin="100,191,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="151" Height="16" Grid.Row="1" Text="Utiliza Conciliador Contábil"/>

        <Button Content="📁" x:Name="txtEditorPathBtn" Click="SelectTextEditorPath_Click" IsTabStop="False" IsEnabled="{Binding appState.Settings.EditorCheckbox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="#411e5a" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Height="21" Width="20" Margin="348,129,0,0" Grid.Row="1">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Border"
                            Background="Transparent"
                            CornerRadius="5"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0">
                        <ContentPresenter x:Name="contentPresenter"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                TextElement.FontSize="{TemplateBinding FontSize}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="#7737A6"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="contentPresenter" Property="TextElement.FontSize" Value="15"/>
                            <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="#411e5a"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="#BFBEBD"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Button Content="📁" x:Name="updateFolderPathBtn" Click="SelectUpdateFolderPath_Click" IsTabStop="False" IsEnabled="{Binding appState.Settings.DirUpdateCheckbox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="#411e5a" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Width="20" BorderBrush="#2a353a"  Background="#101e24" Margin="348,157,0,0" Grid.Row="1">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Border"
                            Background="Transparent"
                            CornerRadius="5"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0">
                        <ContentPresenter x:Name="contentPresenter"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                TextElement.FontSize="{TemplateBinding FontSize}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="#7737A6"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="contentPresenter" Property="TextElement.FontSize" Value="15"/>
                            <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="#411e5a"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="#BFBEBD"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Button Content="Editar Portas" Click="SetPortsButton_Click" IsTabStop="False" BorderThickness="2" Foreground="#411e5a" BorderBrush="#411e5a" Background="#f5f4f3" Margin="100,337,310,60" Grid.Row="1">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="5"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#EBE9E8"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="#5C2A80"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#D9D8D7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <TextBlock Foreground="#7737A6" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="75,30,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="151" Height="16" Grid.Row="1" Text="Geral"/>
        <Rectangle RadiusX="1" RadiusY="1" Height="2" Margin="79,44,182,0" Grid.Row="1" Stroke="#7737A6" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Rectangle.RenderTransform>
        </Rectangle>


        <CheckBox x:Name="useRedirectCheckbox" IsTabStop="False" BorderBrush="#411e5a" Background="#f5f4f3" IsChecked="{Binding Conexao3Camadas.UseRedirect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="CheckBox" HorizontalAlignment="Left" Margin="75,271,0,0" Grid.Row="1" VerticalAlignment="Top" Width="15"/>
        <TextBlock Foreground="#411e5a" HorizontalAlignment="Left" Margin="100,270,0,140" TextWrapping="Wrap" Width="118" Grid.Row="1" Text="Utiliza Redirecionador"/>

        <TextBox x:Name="redirectPort" Text="{Binding Conexao3Camadas.RedirectPort, Mode=TwoWay}" TextAlignment="Center" MaxLength = "5" Foreground="Black" FontSize="11" Margin="227,270,275,139" Grid.Row="1">
            <TextBox.Style>
                <Style TargetType="{x:Type TextBox}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TextBox}">
                                <Border x:Name="Border"
                                    Background="#f5f4f3"  
                                    BorderBrush="#411e5a"  
                                    BorderThickness="1.5"  
                                    CornerRadius="4">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                        Margin="0" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#A6A5A4"/>
                                        <Setter TargetName="Border" Property="Background" Value="#EBE9E8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.Style>
        </TextBox>
        <TextBlock FontSize="9" HorizontalAlignment="Left" Foreground="#411e5a" Margin="222,246,0,155" Grid.Row="1" TextWrapping="Wrap" Text="       Porta Redirecionador" Width="67"/>
        <Button Content="Atualizar Redirecionador" ToolTip="Atualiza o arquivo ConexaoRedireciona.dat" IsTabStop="False" Click="UpdateRedirectorFile_Click" BorderThickness="2" Foreground="#411e5a" BorderBrush="#411e5a" Background="#f5f4f3" Margin="310,337,100,60" Grid.Row="1">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="5"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#EBE9E8"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="#5C2A80"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#D9D8D7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <TextBox x:Name="verifierPort" Text="{Binding Conexao3Camadas.VerifierPort, Mode=TwoWay}" TextAlignment="Center" MaxLength = "5" Foreground="Black" FontSize="11" Padding="1, 0" Margin="297,270,205,139" Grid.Row="1">
            <TextBox.Style>
                <Style TargetType="{x:Type TextBox}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TextBox}">
                                <Border x:Name="Border"
                                    Background="#f5f4f3"  
                                    BorderBrush="#411e5a"  
                                    BorderThickness="1.5"  
                                    CornerRadius="4">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                        Margin="0" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#A6A5A4"/>
                                        <Setter TargetName="Border" Property="Background" Value="#EBE9E8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.Style>
        </TextBox>
        <TextBlock FontSize="9" HorizontalAlignment="Left" Foreground="#411e5a" Margin="300,246,0,155" Grid.Row="1" TextWrapping="Wrap" Text="    Porta Verificador" Width="43"/>
        <TextBox x:Name="dbServer" Text="{Binding Conexao3Camadas.DbServer, Mode=TwoWay}" Foreground="Black" FontSize="11" Padding="1, 0" Margin="200,304,205,105" Grid.Row="1">
            <TextBox.Style>
                <Style TargetType="{x:Type TextBox}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TextBox}">
                                <Border x:Name="Border"
                                    Background="#f5f4f3"  
                                    BorderBrush="#411e5a"  
                                    BorderThickness="1.5"  
                                    CornerRadius="4">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                        Margin="0" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#18262b"/>
                                        <Setter TargetName="Border" Property="Background" Value="#152226"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.Style>
        </TextBox>
        <TextBlock Foreground="#411e5a" HorizontalAlignment="Left" Margin="75,303,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Height="17" Grid.Row="1"><Run Text="Server Redirecionador"/><Run Language="pt-br" Text=":"/><LineBreak/><Run Language="pt-br"/><LineBreak/><Run/></TextBlock>

    </Grid>
</Page>
